{
  "name": "casaclo-gestao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de gestão da Casa Clo — encomendas, clientes, pagamentos (backend Node + PostgreSQL, SPA estática)",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.mjs",
